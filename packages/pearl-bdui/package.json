{
  "name": "pearl-bdui",
  "version": "0.12.3",
  "description": "Pearl: A web UI for the Beads issue tracker",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "pearl-bdui": "bin/pearl.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "bin",
    "frontend-dist"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "build:dist": "node scripts/build-dist.js",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build:dist"
  },
  "keywords": [
    "beads",
    "issue-tracker",
    "project-management",
    "dolt",
    "web-ui"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/htxryan/pearl.git"
  },
  "publishConfig": {
    "provenance": true,
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@fastify/busboy": "^3.2.0",
    "@fastify/static": "^9.1.3",
    "execa": "^9.5.0",
    "fastify": "^5.8.5",
    "file-type": "^22.0.1",
    "mysql2": "^3.22.3",
    "open": "^11.0.0",
    "picocolors": "^1.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@pearl/shared": "workspace:*",
    "@types/node": "^22.19.17",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "zod": "^4.4.3"
  }
}
