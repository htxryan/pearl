---
import CopyButton from "../components/CopyButton.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const features = [
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/><path d="M9 21V9"/></svg>`,
    title: "Visual triage at a glance",
    description:
      "Table views, board views, and dependency graphs. See status, priority, and blockers without leaving your editor's mental model.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M6 8h.01"/><path d="M10 8h.01"/><path d="M14 8h.01"/><path d="m6 12 2 2 4-4"/></svg>`,
    title: "Keyboard-first workflows",
    description:
      "Navigate, filter, and update issues without touching the mouse. Vim-style shortcuts, command palette, and bulk actions built in.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8V4H8"/><rect x="8" y="8" width="8" height="8" rx="1"/><path d="M4 12h4"/><path d="M16 12h4"/><path d="M12 16v4"/></svg>`,
    title: "AI-agent collaboration",
    description:
      "Agents use the Beads CLI to create, update, and close issues. Pearl surfaces their work in real time — triage what your agents produce.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 1v6"/><path d="M12 17v6"/><path d="m5.6 5.6 4.25 4.25"/><path d="m14.15 14.15 4.25 4.25"/><path d="M1 12h6"/><path d="M17 12h6"/><path d="m5.6 18.4 4.25-4.25"/><path d="m14.15 9.85 4.25-4.25"/></svg>`,
    title: "Git-native data layer",
    description:
      "Built on Dolt, every change is a commit. Branch issues alongside code, merge across workstreams, and time-travel through history.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>`,
    title: "One command to start",
    description:
      "Run npx pearl-bdui and you have a full web UI. No accounts, no infrastructure, no configuration files to write.",
  },
  {
    icon: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>`,
    title: "Private by default",
    description:
      "Everything runs on your machine. No telemetry, no cloud sync, no vendor lock-in. Your issues stay yours.",
  },
];
---

<BaseLayout title="Pearl — The Web UI for Beads" description="Pearl is the web UI for the Beads issue tracker. Visual triage, keyboard-driven workflows, and AI-agent collaboration — running locally from a single command.">
  <!-- Hero -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-badge">The Web UI for Beads</div>
      <h1 class="hero-title">
        See your issues,<br />
        <span class="hero-accent">not just track them</span>
      </h1>
      <p class="hero-subtitle">
        Pearl is the visual interface for the Beads issue tracker.
        Table views, board views, keyboard-driven workflows — all running locally from one command.
      </p>
      <div class="hero-cta">
        <CopyButton text="npx pearl-bdui" />
      </div>
      <p class="hero-note">
        Requires Node.js 22+. Starts a local server with the web UI.
      </p>
    </div>
  </section>

  <!-- Product Preview -->
  <section class="preview">
    <div class="preview-inner">
      <div class="preview-window">
        <div class="preview-titlebar">
          <div class="preview-dots">
            <span class="dot dot-red"></span>
            <span class="dot dot-yellow"></span>
            <span class="dot dot-green"></span>
          </div>
          <span class="preview-title">Pearl — Issues</span>
        </div>
        <div class="preview-body">
          <div class="preview-sidebar">
            <div class="sidebar-item active">All Issues</div>
            <div class="sidebar-item">Board View</div>
            <div class="sidebar-item">Dependencies</div>
          </div>
          <div class="preview-main">
            <div class="preview-toolbar">
              <span class="toolbar-filter">Filter</span>
              <span class="toolbar-sort">Priority ↓</span>
            </div>
            <div class="preview-table">
              <div class="table-row header-row">
                <span class="col-status">Status</span>
                <span class="col-title">Title</span>
                <span class="col-priority">Priority</span>
                <span class="col-type">Type</span>
              </div>
              <div class="table-row">
                <span class="col-status"><span class="status-dot in-progress"></span></span>
                <span class="col-title">Add visual triage board view</span>
                <span class="col-priority priority-high">P1</span>
                <span class="col-type">feature</span>
              </div>
              <div class="table-row">
                <span class="col-status"><span class="status-dot open"></span></span>
                <span class="col-title">Keyboard shortcut for bulk assign</span>
                <span class="col-priority priority-med">P2</span>
                <span class="col-type">feature</span>
              </div>
              <div class="table-row">
                <span class="col-status"><span class="status-dot closed"></span></span>
                <span class="col-title">Fix dependency graph rendering</span>
                <span class="col-priority priority-med">P2</span>
                <span class="col-type">bug</span>
              </div>
              <div class="table-row">
                <span class="col-status"><span class="status-dot open"></span></span>
                <span class="col-title">Agent auto-triage pipeline</span>
                <span class="col-priority priority-low">P3</span>
                <span class="col-type">task</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section class="features" id="features">
    <div class="features-inner">
      <h2 class="section-title">Why Pearl?</h2>
      <div class="features-grid">
        {features.map((feature) => (
          <div class="feature-card">
            <div class="feature-icon" aria-hidden="true" set:html={feature.icon} />
            <h3 class="feature-title">{feature.title}</h3>
            <p class="feature-description">{feature.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta">
    <div class="cta-inner">
      <h2 class="cta-title">Start triaging in seconds</h2>
      <p class="cta-subtitle">One command gives you a full issue-tracking UI. No accounts, no setup.</p>
      <div class="cta-copy">
        <CopyButton text="npx pearl-bdui" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* Hero */
  .hero {
    padding: 6rem 1.5rem 4rem;
    text-align: center;
  }

  .hero-inner {
    max-width: 48rem;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-block;
    padding: 0.375rem 1rem;
    margin-bottom: 1.5rem;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--pearl-primary);
    background: var(--pearl-accent);
    border-radius: 9999px;
  }

  .hero-title {
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: var(--pearl-fg);
    margin-bottom: 1.5rem;
  }

  .hero-accent {
    background: linear-gradient(135deg, var(--pearl-gradient-from), var(--pearl-gradient-to));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    line-height: 1.7;
    color: var(--pearl-muted-fg);
    max-width: 36rem;
    margin: 0 auto 2.5rem;
  }

  .hero-cta {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .hero-note {
    font-size: 0.8125rem;
    color: var(--pearl-muted-fg);
    opacity: 0.7;
  }

  /* Features */
  .features {
    padding: 4rem 1.5rem;
    border-top: 1px solid var(--pearl-border);
  }

  .features-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  .section-title {
    font-size: 1.875rem;
    font-weight: 700;
    text-align: center;
    letter-spacing: -0.025em;
    color: var(--pearl-fg);
    margin-bottom: 3rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 1.5rem;
  }

  .feature-card {
    padding: 1.75rem;
    border: 1px solid var(--pearl-border);
    border-radius: var(--pearl-radius);
    background: var(--pearl-surface-raised);
    transition: box-shadow 0.2s, border-color 0.2s;
  }

  .feature-card:hover {
    box-shadow: var(--pearl-shadow-md);
    border-color: var(--pearl-primary);
  }

  .feature-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--pearl-primary);
    background: var(--pearl-accent);
    border-radius: 0.5rem;
  }

  .feature-title {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--pearl-fg);
    margin-bottom: 0.5rem;
  }

  .feature-description {
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--pearl-muted-fg);
  }

  /* Preview */
  .preview {
    padding: 0 1.5rem 4rem;
  }

  .preview-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  .preview-window {
    border: 1px solid var(--pearl-border);
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--pearl-surface);
    box-shadow: var(--pearl-shadow-lg);
  }

  .preview-titlebar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 1rem;
    background: var(--pearl-surface-raised);
    border-bottom: 1px solid var(--pearl-border);
  }

  .preview-dots {
    display: flex;
    gap: 0.375rem;
  }

  .dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
  }

  .dot-red { background: #ef4444; }
  .dot-yellow { background: #eab308; }
  .dot-green { background: #22c55e; }

  .preview-title {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--pearl-muted-fg);
  }

  .preview-body {
    display: flex;
    min-height: 16rem;
  }

  .preview-sidebar {
    width: 10rem;
    flex-shrink: 0;
    border-right: 1px solid var(--pearl-border);
    padding: 0.75rem 0;
  }

  .sidebar-item {
    padding: 0.375rem 1rem;
    font-size: 0.8125rem;
    color: var(--pearl-muted-fg);
    cursor: default;
  }

  .sidebar-item.active {
    color: var(--pearl-primary);
    font-weight: 600;
    background: var(--pearl-accent);
  }

  .preview-main {
    flex: 1;
    min-width: 0;
  }

  .preview-toolbar {
    display: flex;
    gap: 0.75rem;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--pearl-border);
    font-size: 0.75rem;
    color: var(--pearl-muted-fg);
  }

  .toolbar-filter,
  .toolbar-sort {
    padding: 0.125rem 0.5rem;
    border: 1px solid var(--pearl-border);
    border-radius: 0.25rem;
    background: var(--pearl-surface-raised);
  }

  .preview-table {
    font-size: 0.8125rem;
  }

  .table-row {
    display: grid;
    grid-template-columns: 3.5rem 1fr 4.5rem 3.5rem;
    align-items: center;
    padding: 0.5rem 1rem;
    border-bottom: 1px solid var(--pearl-border);
  }

  .table-row:last-child {
    border-bottom: none;
  }

  .header-row {
    font-weight: 600;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--pearl-muted-fg);
    background: var(--pearl-surface-raised);
  }

  .col-title {
    color: var(--pearl-fg);
  }

  .col-priority,
  .col-type {
    color: var(--pearl-muted-fg);
    font-size: 0.75rem;
  }

  .priority-high { color: var(--pearl-danger); font-weight: 600; }
  .priority-med { color: var(--pearl-warning); font-weight: 600; }
  .priority-low { color: var(--pearl-muted-fg); }

  .status-dot {
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
  }

  .status-dot.open { background: var(--pearl-info); }
  .status-dot.in-progress { background: var(--pearl-warning); }
  .status-dot.closed { background: var(--pearl-success); }

  /* CTA */
  .cta {
    padding: 5rem 1.5rem;
    text-align: center;
    border-top: 1px solid var(--pearl-border);
  }

  .cta-inner {
    max-width: 36rem;
    margin: 0 auto;
  }

  .cta-title {
    font-size: 1.875rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--pearl-fg);
    margin-bottom: 0.75rem;
  }

  .cta-subtitle {
    font-size: 1.125rem;
    color: var(--pearl-muted-fg);
    margin-bottom: 2rem;
  }

  .cta-copy {
    display: flex;
    justify-content: center;
  }

  /* Responsive */
  @media (max-width: 640px) {
    .hero {
      padding: 4rem 1rem 3rem;
    }

    .features {
      padding: 3rem 1rem;
    }

    .cta {
      padding: 3rem 1rem;
    }

    .preview {
      padding: 0 1rem 3rem;
    }

    .preview-sidebar {
      display: none;
    }

    .table-row {
      grid-template-columns: 2rem 1fr 2.5rem 3.5rem;
      font-size: 0.75rem;
    }

    .features-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
