---
import { repoUrl } from "../config";

const gradientId = `pearl-icon-${Math.random().toString(36).slice(2, 8)}`;
---

<header class="site-header">
  <nav class="header-nav">
    <a href="/" class="wordmark" aria-label="Pearl home">
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id={gradientId} x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--pearl-gradient-from)"/>
            <stop offset="100%" stop-color="var(--pearl-gradient-to)"/>
          </linearGradient>
        </defs>
        <circle cx="16" cy="16" r="14" fill={`url(#${gradientId})`}/>
        <text x="16" y="22" text-anchor="middle" fill="white" font-family="system-ui,sans-serif" font-weight="700" font-size="18">P</text>
      </svg>
      <span>Pearl</span>
    </a>

    <div class="header-links">
      <a href="/docs/" class="header-link">Docs</a>
      <a href={repoUrl} class="star-btn" target="_blank" rel="noopener noreferrer" aria-label="Star Pearl on GitHub (opens in new tab)">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/>
        </svg>
        <span>Star on GitHub</span>
        <svg class="external-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          <polyline points="15 3 21 3 21 9"/>
          <line x1="10" y1="14" x2="21" y2="3"/>
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--pearl-border);
    background-color: color-mix(in oklch, var(--pearl-bg) 85%, transparent);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
  }

  .header-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--pearl-fg);
    text-decoration: none;
    letter-spacing: -0.025em;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .header-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .header-link {
    color: var(--pearl-muted-fg);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  .header-link:hover {
    color: var(--pearl-fg);
    text-decoration: none;
  }

  .star-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.75rem;
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--pearl-fg);
    background: var(--pearl-surface-raised);
    border: 1px solid var(--pearl-border);
    border-radius: var(--pearl-radius);
    text-decoration: none;
    transition: border-color 0.15s, box-shadow 0.15s, background-color 0.15s;
  }

  .star-btn:hover {
    border-color: var(--pearl-primary);
    box-shadow: var(--pearl-shadow-sm);
    background: var(--pearl-accent);
    text-decoration: none;
  }

  .star-btn:hover svg:first-child {
    fill: currentColor;
  }

  .star-btn svg {
    flex-shrink: 0;
  }

  .external-icon {
    opacity: 0.5;
    margin-left: -0.125rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .star-btn,
    .header-link {
      transition: none;
    }
  }
</style>
