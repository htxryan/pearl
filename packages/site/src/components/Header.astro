---
const repoUrl = "https://github.com/htxryan/pearl";
---

<header class="site-header">
  <nav class="header-nav">
    <a href="/" class="wordmark" aria-label="Pearl home">
      <svg width="28" height="28" viewBox="0 0 32 32" aria-hidden="true">
        <defs>
          <linearGradient id="pearl-icon" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0%" stop-color="var(--pearl-gradient-from)"/>
            <stop offset="100%" stop-color="var(--pearl-gradient-to)"/>
          </linearGradient>
        </defs>
        <circle cx="16" cy="16" r="14" fill="url(#pearl-icon)"/>
        <text x="16" y="22" text-anchor="middle" fill="white" font-family="system-ui,sans-serif" font-weight="700" font-size="18">P</text>
      </svg>
      <span>Pearl</span>
    </a>

    <div class="header-links">
      <a href="/docs/" class="header-link">Docs</a>
      <a href={repoUrl} class="github-link" target="_blank" rel="noopener noreferrer" aria-label="Pearl on GitHub">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
        </svg>
      </a>
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--pearl-border);
    background-color: var(--pearl-bg);
    backdrop-filter: blur(12px);
  }

  .header-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 72rem;
    margin: 0 auto;
    padding: 0.875rem 1.5rem;
  }

  .wordmark {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--pearl-fg);
    text-decoration: none;
    letter-spacing: -0.025em;
  }

  .wordmark:hover {
    text-decoration: none;
  }

  .header-links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .header-link {
    color: var(--pearl-muted-fg);
    font-size: 0.9375rem;
    font-weight: 500;
    transition: color 0.15s;
  }

  .header-link:hover {
    color: var(--pearl-fg);
    text-decoration: none;
  }

  .github-link {
    display: flex;
    align-items: center;
    color: var(--pearl-muted-fg);
    transition: color 0.15s;
  }

  .github-link:hover {
    color: var(--pearl-fg);
  }
</style>
