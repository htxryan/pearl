{
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter pearl-bdui dev",
    "build": "pnpm -r --filter='!@pearl/site' build",
    "test": "pnpm -r --filter='!@pearl/site' test",
    "test:coverage": "pnpm -r --filter='!@pearl/site' test -- --coverage",
    "typecheck": "pnpm -r --filter='!@pearl/site' typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:e2e": "playwright test",
    "test:e2e:read": "playwright test --project=chromium",
    "test:e2e:write": "playwright test --project=write-tests",
    "test:e2e:ui": "playwright test --ui",
    "lint:deps": "depcruise packages/*/src --config .dependency-cruiser.cjs",
    "lint:lucide": "bash scripts/lint-lucide-imports.sh",
    "lint:invariants": "bash scripts/lint-invariants.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "packages/frontend/src/**/*.{ts,tsx}": [
      "bash scripts/lint-lucide-imports.sh",
      "bash scripts/lint-invariants.sh"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@biomejs/biome": "^2.4.13",
    "@playwright/test": "^1.59.1",
    "@vitest/coverage-v8": "^3.2.4",
    "compound-agent": "^2.7.2",
    "dependency-cruiser": "^17.3.10",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2"
    }
  }
}
